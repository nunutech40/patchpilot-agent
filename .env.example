# PatchPilot runtime secrets.
# Store real values in Google Cloud Secret Manager. Never commit real values.

# Google Cloud primary hackathon deployment.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
AGENT_BUILDER_AGENT_ID=
AGENT_BUILDER_DATA_STORE_ID=
CLOUD_RUN_RUNTIME_URL=
CLOUD_RUN_POLICY_INGESTION_URL=
SECRET_MANAGER_PREFIX=

# Agent 1: patchpilot-runtime.
# User-facing Telegram, GitLab, Elastic read, and Antigravity execution.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ALLOWED_CHAT_IDS=

# GitLab token used only for demo repositories.
GITLAB_BASE_URL=https://gitlab.com
GITLAB_TOKEN=

ELASTICSEARCH_URL=
ELASTIC_READ_API_KEY=
ELASTICSEARCH_INDEX=platform_policy_updates

PATCHPILOT_RUNTIME_AGENT_ID=patchpilot-runtime

# Agent 2: policy-context.
# Background/manual policy crawl, AI extraction, and Elastic write/upsert.
ELASTIC_WRITE_API_KEY=
POLICY_CONTEXT_AGENT_ID=policy-context
POLICY_CRAWL_ALLOWED_DOMAINS=developer.android.com,support.google.com,developer.apple.com,docs.flutter.dev

# Gemini / model provider.
GEMINI_API_KEY=
GEMINI_MODEL=

# Antigravity coding worker.
# PatchPilot uses Google Cloud for orchestration and Antigravity for repo edits.
ANTIGRAVITY_API_KEY=
ANTIGRAVITY_MODEL=
ANTIGRAVITY_CLI_PATH=antigravity

# Optional ideal-mode persistence. Leave empty for Telegram MVP.
MONGODB_URI=

# PatchPilot service settings.
PATCHPILOT_ENV=production
PATCHPILOT_WORKSPACE=/workspace
