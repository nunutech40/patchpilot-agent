# PatchPilot runtime secrets
# Copy to .env on the VPS only. Never commit real values.

# Telegram bot used only for PatchPilot hackathon/demo flow.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ALLOWED_CHAT_IDS=

# GitLab token used only for demo repositories.
GITLAB_BASE_URL=https://gitlab.com
GITLAB_TOKEN=

# Elastic policy context layer.
ELASTICSEARCH_URL=
ELASTIC_READ_API_KEY=
ELASTIC_WRITE_API_KEY=
ELASTICSEARCH_INDEX=platform_policy_updates

# OpenClaw agent IDs.
PATCHPILOT_RUNTIME_AGENT_ID=patchpilot-runtime
POLICY_CONTEXT_AGENT_ID=policy-context
POLICY_CRAWL_ALLOWED_DOMAINS=developer.android.com,support.google.com,developer.apple.com,docs.flutter.dev

# OpenClaw / model provider.
OPENCLAW_API_KEY=
OPENCLAW_MODEL=

# Antigravity coding worker.
# PatchPilot uses OpenClaw for orchestration and Antigravity for repo edits.
ANTIGRAVITY_API_KEY=
ANTIGRAVITY_MODEL=
ANTIGRAVITY_CLI_PATH=antigravity

# Optional ideal-mode persistence. Leave empty for Telegram MVP.
MONGODB_URI=

# PatchPilot service settings.
PATCHPILOT_ENV=production
PATCHPILOT_GATEWAY_PORT=18889
PATCHPILOT_WORKSPACE=/workspace
