# VPS-only environment template for /opt/patchpilot/.env
# Keep this file as documentation. Put real values only on the server.

COMPOSE_PROJECT_NAME=patchpilot
OPENCLAW_VERSION=2026.5.20
PATCHPILOT_GATEWAY_PORT=18889

# Agent 1: patchpilot-runtime.
# User-facing Telegram, GitLab, Elastic read, and Antigravity execution.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ALLOWED_CHAT_IDS=

GITLAB_BASE_URL=https://gitlab.com
GITLAB_TOKEN=

ELASTICSEARCH_URL=
ELASTIC_READ_API_KEY=
ELASTICSEARCH_INDEX=platform_policy_updates

PATCHPILOT_RUNTIME_AGENT_ID=patchpilot-runtime

# Agent 2: policy-context.
# Background/manual policy crawl, AI extraction, and Elastic write/upsert.
ELASTIC_WRITE_API_KEY=
POLICY_CONTEXT_AGENT_ID=policy-context
POLICY_CRAWL_ALLOWED_DOMAINS=developer.android.com,support.google.com,developer.apple.com,docs.flutter.dev

OPENCLAW_API_KEY=
OPENCLAW_MODEL=

ANTIGRAVITY_API_KEY=
ANTIGRAVITY_MODEL=
ANTIGRAVITY_CLI_PATH=antigravity

MONGODB_URI=
