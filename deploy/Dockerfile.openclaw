ARG NODE_VERSION=24-bookworm-slim
FROM node:${NODE_VERSION}

ARG OPENCLAW_VERSION=2026.5.20

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    openssh-client \
  && rm -rf /var/lib/apt/lists/*

RUN npm install -g "openclaw@${OPENCLAW_VERSION}"

RUN useradd --create-home --shell /bin/bash patchpilot
USER patchpilot
WORKDIR /home/patchpilot

ENV HOME=/home/patchpilot
ENV PATH=/usr/local/bin:$PATH
ENV PATCHPILOT_WORKSPACE=/workspace

RUN mkdir -p /home/patchpilot/.openclaw /workspace

EXPOSE 18889

CMD ["openclaw", "gateway", "--port", "18889"]
